{
  "name": "dynasty-sim-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lore:check && npm run lore:compile && tsc --noEmit && npm test && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "lore:check": "tsx src/lore/validate.ts",
    "lore:compile": "tsx src/lore/compile.ts",
    "sim:check": "tsx src/simcheck.ts",
    "test": "tsx --test src/engine/persistence.test.ts && npm run sim:check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5"
  }
}
