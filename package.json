{
  "name": "dynasty-sim-core",
  "version": "0.7.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lore:check && npm run lore:compile && tsc --noEmit && npm test && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "lore:check": "tsx src/lore/validate.ts",
    "lore:compile": "tsx src/lore/compile.ts",
    "sim:check": "tsx src/simcheck.ts",
    "sim:policy": "tsx src/simpolicy.ts",
    "art:prompts": "tsx src/art/prompts.ts",
    "art:ingest": "tsx src/art/ingest.ts",
    "test": "tsx --test src/engine/persistence.test.ts src/art/select.test.ts src/release.test.ts && npm run sim:check -- 30"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.2.7",
    "sharp": "^0.33.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.5"
  }
}
