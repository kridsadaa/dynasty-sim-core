  "fiction": {
    "_comment": "เรื่องสมมติหลัง พ.ศ. 2400 — ไม่อิงเหตุการณ์จริง ตัวเลขทั้งหมดเป็นของเกม (invented) จั่วแบบ shuffle bag ทุก gap ปี ดู src/systems/fiction.ts",
    "startYear": 2400,
    "gap": [8, 15],
    "deck": [
      { "tag": "fiction:plague_wave", "kind": "plague",
        "shock": { "wealthLoss":[0,0], "deathRisk":0.1, "everyone":true },
        "note": "โรคห่าลงบ้านลงเมือง คนล้มป่วยทั้งตรอก เสียงสวดมนต์ดังไม่ขาดหลายเดือน" },
      { "tag": "fiction:great_flood", "kind": "famine",
        "shock": { "wealthLoss":[0.05,0.2], "deathRisk":0.02, "everyone":true },
        "note": "น้ำหลากท่วมถึงชานเรือน ข้าวในนาเน่า ของที่เก็บใต้ถุนลอยไปกับน้ำ" },
      { "tag": "fiction:drought", "kind": "famine", "lasts": 2,
        "shock": { "wealthLoss":[0,0.08], "deathRisk":0.04, "everyone":true },
        "note": "ฝนทิ้งช่วงนาน ท้องนาแตกระแหง ข้าวขึ้นราคาจนคนจนต้องกินข้าวต้มเจือน้ำ" },
      { "tag": "fiction:city_fire", "kind": "famine",
        "shock": { "wealthLoss":[0.05,0.25], "deathRisk":0.01, "everyone":true },
        "note": "ไฟลามจากโรงครัวข้างบ้านข้ามหลังคาไปทั้งย่าน เรือนไม้ไผ่ไหม้เหลือแต่เสา" },
      { "tag": "fiction:border_war", "kind": "war", "lasts": 2,
        "shock": { "wealthLoss":[0,0.04], "deathRisk":0.03, "deathRiskBySex":{ "m":0.06, "f":0.01 }, "ages":[18,50] },
        "note": "มีรับสั่งเรียกพลไปชายแดน ผู้ชายวัยฉกรรจ์ในย่านถูกเกณฑ์ไปเกือบหมด" },
      { "tag": "fiction:great_war", "kind": "war", "lasts": 3,
        "shock": { "wealthLoss":[0.1,0.35], "deathRisk":0.07, "deathRiskBySex":{ "m":0.13, "f":0.02 }, "ages":[16,55] },
        "note": "ศึกใหญ่ลุกลามทั่วแผ่นดิน ข้าวของแพงและผู้คนล้มตายทั้งสองฝ่าย" },
      { "tag": "fiction:bandit_surge", "kind": "war",
        "shock": { "wealthLoss":[0.02,0.15], "deathRisk":0.01 },
        "note": "โจรชุมตามชายป่า ปล้นเรือสินค้าและบุกบ้านที่อยู่ห่างชุมชนทุกคืน" },
      { "tag": "fiction:court_turmoil", "kind": "succession",
        "shock": { "wealthLoss":[0,0.1], "deathRisk":0.01 },
        "note": "ราชสำนักผลัดเปลี่ยนผู้ใหญ่ ใครเคยพึ่งใครต้องเดินหาหลังพิงกันใหม่ ใครเลือกผิดข้างเสียทั้งทรัพย์และหน้า" },
      { "tag": "fiction:heavy_levy", "kind": "succession",
        "shock": { "wealthLoss":[0.05,0.2], "deathRisk":0 },
        "note": "ส่วยและภาษีรีดหนักปีนี้ ขุนนางเก็บยุ้งฉางจนแทบโล่ง ทุกบ้านต้องควักเงินส่งหลวง" },
      { "tag": "fiction:good_harvest", "kind": "boon",
        "shock": { "wealthLoss":[-0.12,-0.04], "deathRisk":0 },
        "note": "ฝนมาตามฤดู ข้าวออกรวงเต็มท้องนา ยุ้งฉางเต็ม ทุกบ้านพอกินพอขาย" },
